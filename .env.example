# Base URL for the real backend API.
# The scaffold ships with an in-memory mock (see src/features/items/items.mock.ts),
# so this is only needed once you switch items.api.ts from `queryFn` to `query`.
VITE_API_BASE_URL=/api

# Connection test on every app render (GET, logs success/failure).
# By default it hits `${VITE_API_BASE_URL}/hello` (locally
# http://localhost:8765/hello). Set VITE_RENDER_PING_URL to override with a
# full URL (e.g. the environment's sidecar path). Leave both empty to disable.
VITE_RENDER_PING_URL=

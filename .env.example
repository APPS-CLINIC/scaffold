# Browser-facing API base path. Keep this relative when using the dev proxy.
VITE_API_BASE_URL=/api

# Real backend origin used by Vite during `npm run dev`.
API_PROXY_TARGET=http://localhost:8765

# Optional development-only first-view data. Copy to `.env.development.local`
# and uncomment when the backend is temporarily unavailable.
# VITE_PREVIEW_DATA_PROFILE=customers

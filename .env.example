# Base URL for the real backend API.
# The scaffold ships with an in-memory mock (see src/features/items/items.mock.ts),
# so this is only needed once you switch items.api.ts from `queryFn` to `query`.
VITE_API_BASE_URL=/api

# Optional: endpoint pinged every time the app is rendered.
# When set, Vite injects a client-side ping on each browser load (A) and
# pings server-side on each dev-server HTML request (B). Leave empty to disable.
VITE_RENDER_PING_URL=
